{
  "name": "heeva-clinic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HEEVA CLINIC MANAGEMENT SYSTEM - Complete clinic management PWA",
  "scripts": {
    "dev": "concurrently \"npm run worker:dev\" \"vite\"",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.js",
    "test:uhid": "esbuild scripts/test-uhid-sequence.mjs --bundle --platform=node --format=esm --external:dexie --external:fake-indexeddb --outfile=.test-uhid.bundle.mjs --log-level=warning && node --import ./scripts/fidb-first.mjs .test-uhid.bundle.mjs",
    "smoke": "esbuild scripts/smoke.mjs --bundle --platform=node --format=esm --external:dexie --external:fake-indexeddb --outfile=.smoke.bundle.mjs --log-level=warning && node --import ./scripts/fidb-first.mjs .smoke.bundle.mjs",
    "render": "esbuild scripts/render-test.mjs --bundle --platform=node --format=esm --packages=external --outfile=.render.bundle.mjs --log-level=warning && node --import ./scripts/fidb-first.mjs .render.bundle.mjs",
    "test:multi-device": "node --import ./scripts/fidb-first.mjs scripts/test-multi-device.mjs",
    "test:medicines": "node --import ./scripts/fidb-first.mjs scripts/test-medicine-sync-and-persistence.mjs",
    "test:csv": "node scripts/test-global-csv-regression.mjs",
    "test:migration": "node --import ./scripts/fidb-first.mjs scripts/test-dexie-v7-migration.mjs",
    "test:keyboard": "esbuild scripts/test-keyboard-form-submissions.mjs --bundle --platform=node --format=esm --packages=external --outfile=.test-kb.bundle.mjs --log-level=warning && node .test-kb.bundle.mjs",
    "test:add-patient": "esbuild scripts/test-add-patient-flow.mjs --bundle --platform=node --format=esm --external:dexie --external:fake-indexeddb --outfile=.test-add-patient.bundle.mjs --log-level=warning && node --import ./scripts/fidb-first.mjs .test-add-patient.bundle.mjs",
    "test:separation": "esbuild scripts/test-patient-validation-separation.mjs --bundle --platform=node --format=esm --external:dexie --external:fake-indexeddb --outfile=.test-separation.bundle.mjs --log-level=warning && node --import ./scripts/fidb-first.mjs .test-separation.bundle.mjs",
    "test": "npm run test:uhid && npm run smoke && npm run render && npm run test:keyboard && npm run test:add-patient && npm run test:separation && npm run test:csv && npm run test:migration"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "concurrently": "^9.2.4",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
