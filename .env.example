# HEEVA CLINIC - Environment Configuration Example

# Server Port
# Automatically set by Render in production (e.g. 10000). Defaults to 3001 locally.
PORT=3001

# Persistent JSON Storage Directory
# Local development default: server/data
# Render with Persistent Disk: /data (mount disk to /data and set DATA_DIR=/data)
DATA_DIR=server/data

# Environment Mode
NODE_ENV=production
