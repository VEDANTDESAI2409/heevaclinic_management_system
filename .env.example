# HEEVA CLINIC - Cloudflare Environment Configuration Example

# Local Cloudflare Worker Port (defaults to 8787 via Wrangler)
WORKER_PORT=8787

# Optional: Remote Worker API Base URL (if frontend and worker are hosted on separate domains)
# When deployed together or via Cloudflare Pages proxy, leave empty to use same-origin '/api'
# VITE_API_URL=https://heeva-clinic-backend.<your-subdomain>.workers.dev
